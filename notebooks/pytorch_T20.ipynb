        "%cd /content/t20-brain-tumor-detection\n",
        "import pandas as pd\n",
        "df = pd.read_csv(\"split_manifest.csv\")\n",
        "df[\"path\"] = \"/content/t20-brain-tumor-detection/\" + df[\"path\"]\n",
