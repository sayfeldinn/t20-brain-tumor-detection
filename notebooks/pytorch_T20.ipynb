      "execution_count": 5,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "torch.Size([32, 3, 224, 224]) torch.float32 0.0 1.0\n",
            "4760 840 1600\n"
          ]
