    {
      "cell_type": "code",
      "source": [
        "CLASSES = [\"glioma\", \"meningioma\", \"notumor\", \"pituitary\"]\n",
        "SEED = 42\n",
        "IMAGE_SIZE = 224\n",
        "BATCH_SIZE = 32\n",
        "\n",
        "import os, random\n",
        "import numpy as np\n",
        "import torch\n",
        "def seed_everything(seed=SEED):\n",
        "    os.environ[\"PYTHONHASHSEED\"] = str(seed)\n",
        "    random.seed(seed); np.random.seed(seed)\n",
        "    torch.manual_seed(seed); torch.cuda.manual_seed_all(seed)\n",
        "    torch.backends.cudnn.deterministic = True\n",
        "    torch.backends.cudnn.benchmark = False\n",
        "seed_everything()"
      ],
      "metadata": {
        "id": "OvmiRcqcg0Cr"
      },
      "execution_count": 4,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "from PIL import Image\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "from torchvision import transforms as T\n",
        "\n",
        "train_df = df[df.split == \"train\"].reset_index(drop=True)\n",
        "val_df   = df[df.split == \"val\"].reset_index(drop=True)\n",
        "test_df  = df[df.split == \"test\"].reset_index(drop=True)\n",
        "\n",
        "class MRIDataset(Dataset):\n",
        "    def __init__(self, frame, tf):\n",
        "        self.paths = frame[\"path\"].tolist()\n",
        "        self.labels = [CLASSES.index(l) for l in frame[\"label\"]]\n",
        "        self.tf = tf\n",
        "    def __len__(self):\n",
        "        return len(self.paths)\n",
        "    def __getitem__(self, i):\n",
        "        img = Image.open(self.paths[i]).convert(\"RGB\")\n",
        "        return self.tf(img), self.labels[i]\n",
        "\n",
        "\n",
        "train_tf = T.Compose([\n",
        "    T.Resize((IMAGE_SIZE, IMAGE_SIZE)),\n",
        "    T.RandomAffine(degrees=10, translate=(0.1, 0.1), scale=(0.9, 1.1)),\n",
        "    T.ColorJitter(brightness=0.1, contrast=0.1),\n",
        "    T.ToTensor(),\n",
        "])\n",
        "\n",
        "eval_tf = T.Compose([\n",
        "    T.Resize((IMAGE_SIZE, IMAGE_SIZE)),\n",
        "    T.ToTensor(),\n",
        "])\n",
        "\n",
        "train_ds = MRIDataset(train_df, train_tf)\n",
        "val_ds   = MRIDataset(val_df, eval_tf)\n",
        "test_ds  = MRIDataset(test_df, eval_tf)\n",
        "\n",
        "g = torch.Generator().manual_seed(SEED)\n",
        "train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True, generator=g, num_workers=2)\n",
        "val_loader   = DataLoader(val_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=2)\n",
        "test_loader  = DataLoader(test_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=2)\n",
        "\n",
        "\n",
        "xb, yb = next(iter(train_loader))\n",
        "print(xb.shape, xb.dtype, xb.min().item(), xb.max().item())\n",
        "print(len(train_ds), len(val_ds), len(test_ds))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Vi0WwOd-hOv6",
        "outputId": "6e0cf1ed-e4c9-491c-c1ab-a0e994fac6e6"
