            "/content/t20-brain-tumor-detection\n",
            "label  glioma  meningioma  notumor  pituitary\n",
            "split                                        \n",
            "test      400         400      400        400\n",
            "train    1190        1190     1190       1190\n",
            "val       210         210      210        210\n"
